# Copia este archivo a ".env" y completa los valores.

# Obligatoria: tu clave GRATIS de Google Gemini.
# Consiguela en https://aistudio.google.com/apikey (solo necesitas una cuenta de Google,
# sin tarjeta de credito).
GEMINI_API_KEY=

# Opcional pero MUY recomendable si vas a publicar la app en internet:
# si la defines, la app pedira esta contrasena antes de dejar usarla.
# Sin esto, cualquiera que visite tu URL puede usar tu cuota gratuita (y agotarla).
APP_PASSWORD=

# Opcional: puerto del servidor (por defecto 3000)
PORT=3000
